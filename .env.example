# Copy to a private location and fill in the tokens. Do not commit real secrets.
GITHUB_USERNAME=your-github-login
GITHUB_TOKEN=github_fine_grained_read_only_token

# Base URL only; do not append /api/v1.
FORGEJO_URL=https://forgejo.example.com
FORGEJO_USERNAME=your-forgejo-login
FORGEJO_TOKEN=forgejo_repository_token

# Optional settings (shown with the program defaults).
GITHUB_API_URL=https://api.github.com
MIRROR_INTERVAL=15m
MIRROR_VISIBILITY=private
MIRROR_LFS=true
REQUEST_TIMEOUT_SECONDS=30
MIGRATION_TIMEOUT_SECONDS=3600
DRY_RUN=false
LOG_LEVEL=INFO
# Set true only for a trusted private-network Forgejo instance using HTTP.
ALLOW_INSECURE_FORGEJO=false

[Unit]
Description=Discover GitHub repositories and provision Forgejo pull mirrors
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/opt/github-forgejo-mirror
EnvironmentFile=%h/.config/github-forgejo-mirror.env
ExecStart=%h/.local/opt/github-forgejo-mirror/.venv/bin/python %h/.local/opt/github-forgejo-mirror/github_forgejo_mirror.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/github-forgejo-mirror
